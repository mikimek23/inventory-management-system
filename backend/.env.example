# Backend Server Configuration
PORT=5000
FRONTEND_URL="http://localhost:5173"

# Database Connection (PostgreSQL)
# Format: postgres://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgres://postgres:your_secure_password@localhost:5432/inventory_management_system"

# Authentication Secrets (Generate secure random 64+ character strings in production)
JWT_ACCESS_SECRET="replace_with_a_secure_random_string_for_access_token_generation"
JWT_REFRESH_SECRET="replace_with_a_secure_random_string_for_refresh_token_generation"

# Token Expiration Settings
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
