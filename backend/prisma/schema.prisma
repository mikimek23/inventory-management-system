// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// enum
enum UserRole {
  ADMIN
  STAFF
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum TxnStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum AdjustmentType {
  INCREASE
  DECREASE
}

//models
model User {
  id                  String            @id @default(uuid()) @db.Uuid
  name                String
  email               String            @unique
  passwordHash        String            @map("password_hash")
  role                UserRole          @default(STAFF)
  status              RecordStatus      @default(INACTIVE)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  purchases           Purchase[]
  sales               Sale[]
  stockAdjustments    StockAdjustment[]
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([status])
  @@map("users")
}

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  code        String       @unique
  skuSequence Int          @default(0)
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  products    Product[]

  @@index([status])
  @@map("categories")
}

model Product {
  id               String            @id @default(uuid()) @db.Uuid
  categoryId       String            @map("category_id") @db.Uuid
  name             String
  sku              String            @unique
  unit             String
  costPrice        Decimal           @map("cost_price") @db.Decimal(12, 2)
  sellingPrice     Decimal           @map("selling_price") @db.Decimal(12, 2)
  minimumStock     Decimal           @default(0) @map("minimum_stock") @db.Decimal(12, 2)
  status           RecordStatus      @default(ACTIVE)
  category         Category          @relation(fields: [categoryId], references: [id])
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  purchaseItems    PurchaseItem[]
  saleItems        SaleItem[]
  stockAdjustments StockAdjustment[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model Supplier {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  phone     String
  email     String?
  address   String?
  notes     String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  purchases Purchase[]

  @@index([status])
  @@map("suppliers")
}

model Customer {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  phone     String
  email     String?
  address   String?
  notes     String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  sales     Sale[]

  @@index([status])
  @@map("customers")
}

model Purchase {
  id              String    @id @default(uuid()) @db.Uuid
  supplierId      String    @map("supplier_id") @db.Uuid
  createdById     String    @map("created_by_id") @db.Uuid
  referenceNumber String    @unique @map("reference_number")
  transactionDate DateTime  @default(now()) @map("transaction_date")
  status          TxnStatus @default(DRAFT)
  notes           String?
  total           Decimal   @default(0) @db.Decimal(14, 2)
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  createdBy       User      @relation(fields: [createdById], references: [id])
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  purchaseItems PurchaseItem[]

  @@index([supplierId])
  @@index([createdById])
  @@index([transactionDate])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid()) @db.Uuid
  purchaseId String   @map("purchase_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  quantity   Decimal  @db.Decimal(12, 2)
  unitCost   Decimal  @map("unit_cost") @db.Decimal(12, 2)
  lineTotal  Decimal  @map("line_total") @db.Decimal(14, 2)
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([purchaseId, productId])
  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Sale {
  id              String     @id @default(uuid()) @db.Uuid
  customerId      String?    @map("customer_id") @db.Uuid
  createdById     String     @map("created_by_id") @db.Uuid
  referenceNumber String     @unique @map("reference_number")
  transactionDate DateTime   @default(now()) @map("transaction_date")
  status          TxnStatus  @default(DRAFT)
  notes           String?
  total           Decimal    @default(0) @db.Decimal(14, 2)
  customer        Customer?  @relation(fields: [customerId], references: [id])
  createdBy       User       @relation(fields: [createdById], references: [id])
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  saleItems       SaleItem[]

  @@index([customerId])
  @@index([createdById])
  @@index([transactionDate])
  @@index([status])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal Decimal @map("line_total") @db.Decimal(14, 2)
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model StockAdjustment {
  id          String         @id @default(uuid()) @db.Uuid
  productId   String         @map("product_id") @db.Uuid
  createdById String         @map("created_by_id") @db.Uuid
  type        AdjustmentType
  quantity    Decimal        @db.Decimal(12, 2)
  reason      String
  product     Product        @relation(fields: [productId], references: [id])
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([productId])
  @@index([createdById])
  @@index([createdAt])
  @@map("stock_adjustments")
}
